# Copy to .env and fill in real values. .env is gitignored.
# All four are REQUIRED — docker compose will refuse to start without them.

POSTGRES_PASSWORD=change_me_to_something_long
GRAFANA_PASSWORD=change_me_too

# Alpaca PAPER keys (https://app.alpaca.markets/paper/dashboard/overview)
# Make sure these are paper-trading keys, not live.
ALPACA_API_KEY=your_paper_key_here
ALPACA_API_SECRET=your_paper_secret_here
